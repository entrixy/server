# For an nginx you edit by hand: a whole server block of its own.
# The certificate is yours; the containers stay on the loopback address.
#
# For a control panel (Hestia, ISPmanager) use the other sample instead —
# a whole server block cannot go into an include there.

server {
    listen 443 ssl;
    http2 on;
    server_name gate.example.com;

    ssl_certificate     /path/to/fullchain.pem;
    ssl_certificate_key /path/to/privkey.pem;

    location /ws {
        proxy_pass http://127.0.0.1:8095;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # A websocket connection is long-lived: without these it is cut after
        # a minute of silence and the phone reconnects over and over.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        proxy_pass http://127.0.0.1:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 16m;
    }
}
