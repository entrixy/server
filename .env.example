# The server's domain. Its A record must point at this machine.
DOMAIN=entrixy.example.com

# How HTTPS is served. Two modes:
#   behind an existing proxy (the default) — the certificate and the ports
#     belong to the nginx already on the machine; the containers listen on
#     the loopback address only;
#   Caddy of its own — if the machine is clean and 80/443 are free:
#     docker compose --profile tls up -d --build
HTTP_BIND=127.0.0.1:8082
WS_BIND=127.0.0.1:8095

# Database. Make up any passwords you like — they are not exposed outside.
DB_NAME=entrixy
DB_USER=entrixy
DB_PASS=CHANGE_ME
DB_ROOT_PASS=CHANGE_ME_TOO

# Secret used to sign sessions. Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_RANDOM_HEX

# Secret used to verify the app. Keys the owner marked as "app only" are
# signed by the app with a secret from its own build, and the server checks
# that signature with the same secret. For the app from the store the value is
# the one below. If you build the app yourself, use your own on both sides.
# Mismatched values make those keys stop opening; ordinary keys keep working.
APP_ATTEST_SECRET=eNtR1xy_App_Att3st_2026_9f4Kq2Lm7Xb!

# Optional
WS_PORT=8095
# How many openings a single key may ask for in a minute.
RATE_LIMIT_PER_MIN=60
# How many requests one address may send to one endpoint in a minute. This is
# the floor under every endpoint; the sensitive ones are held tighter in the
# code. Thousands of subscribers can sit behind one carrier address, so do not
# set it low without a reason.
REQUESTS_PER_MIN=300

# A server for your own people. One shared code for everybody: a device that
# did not send it is not created on the server. Empty means the door is open,
# unless at least one invitation has been issued (see the README, "A server
# for your own people only").
ACCESS_CODE=
