# For a control panel (Hestia, ISPmanager): this file is included INSIDE an
# existing server block, so it must not contain a server block of its own —
# nginx would refuse with "duplicate location".
#
# In such a block `location /` already belongs to the panel, so the root is
# declared as the regex `location ~ ^/`, which the panel's prefix location
# does not shadow. `/ws` is declared as `location ^~ /ws`: a prefix match with
# ^~ beats the regex above, which is what makes the websocket upgrade reach
# the worker instead of the PHP part.

# Files that live in the root of the distribution: the stylesheet, the icons and
# robots.txt. A panel's own config usually carries a regex for static extensions
# (css, png, ico and so on) that serves them from its own document root, where
# they do not exist — so they answer 404 while the pages themselves work. The
# three prefix blocks below do not cover them: those files are not under /img/,
# /fonts/ or /app/.
#
# An exact match wins over any regex in nginx, whatever the order of the
# includes, which is why these are written as `location = `.
location = /assets.css        { proxy_pass http://127.0.0.1:8082; proxy_set_header Host $host; }
location = /favicon.ico       { proxy_pass http://127.0.0.1:8082; proxy_set_header Host $host; }
location = /favicon.png       { proxy_pass http://127.0.0.1:8082; proxy_set_header Host $host; }
location = /favicon.svg       { proxy_pass http://127.0.0.1:8082; proxy_set_header Host $host; }
location = /apple-touch-icon.png { proxy_pass http://127.0.0.1:8082; proxy_set_header Host $host; }
location = /robots.txt        { proxy_pass http://127.0.0.1:8082; proxy_set_header Host $host; }

location ^~ /img/ {
    proxy_pass http://127.0.0.1:8082;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location ^~ /fonts/ {
    proxy_pass http://127.0.0.1:8082;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location ^~ /app/ {
    proxy_pass http://127.0.0.1:8082;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location ^~ /ws {
    proxy_pass http://127.0.0.1:8095;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
}

location ~ ^/ {
    proxy_pass http://127.0.0.1:8082;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 16m;
}
