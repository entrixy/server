# Entrixy without Docker: nginx in front of PHP-FPM and the websocket worker.
# nginx does not read .htaccess, so the routes and the denials live here.
# Replace your.server, the paths and the PHP-FPM socket with your own.

# The language prefix of a clean address (/ru/key → ?__lang=ru), passed to PHP.
map $arg___lang $entrixy_lang {
    ~^(ru|de|es|fr|pt|zh)$ $arg___lang;
    default "";
}

server {
    listen 443 ssl;
    http2 on;
    server_name your.server;

    ssl_certificate     /etc/letsencrypt/live/your.server/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your.server/privkey.pem;

    root  /opt/entrixy/dist;
    index index.php;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Nothing private is served: settings, libraries, logs, dumps, hidden files.
    location ~ /\.(?!well-known/)            { deny all; }
    location ~ ^/(lib|partials|lang|sql|mail|vendor)/ { deny all; }
    location ~ (^|/)_[^/]*\.php$             { deny all; }
    location ~ \.(log|sql|tsv|ini|bak|sh|env|lock|md)$ { deny all; }

    # The live connection goes to the worker.
    location /ws {
        proxy_pass http://127.0.0.1:8095;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Clean addresses (what .htaccess does under Apache).
    rewrite "^/healthz/?$"                                   /api/health.php last;
    rewrite "^/key/?$"                                       /key.php last;
    rewrite "^/(ru|de|es|fr|pt|zh)/key/?$"                   /key.php?__lang=$1 last;
    rewrite "^/i/([A-Za-z0-9_-]{10,22})/?$"                  /key_invite.php?code=$1 last;
    rewrite "^/(ru|de|es|fr|pt|zh)/i/([A-Za-z0-9_-]{10,22})/?$" /key_invite.php?code=$2&__lang=$1 last;
    rewrite "^/[co]/([A-Za-z0-9_-]{6,16})/?$"                /company_invite.php?code=$1 last;
    rewrite "^/(ru|de|es|fr|pt|zh)/[co]/([A-Za-z0-9_-]{6,16})/?$" /company_invite.php?code=$2&__lang=$1 last;

    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        # The language of the address, as Apache's SITELANG (map at the top).
        fastcgi_param SITELANG $entrixy_lang;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}

server {
    listen 80;
    server_name your.server;
    return 301 https://$host$request_uri;
}
